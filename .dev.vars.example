# Local Workers secrets for `pnpm dev` / `vite preview` (Cloudflare Vite plugin).
# Copy to `.dev.vars` (gitignored via *.local / .wrangler patterns — also listed in .gitignore).
# Same keys as production `wrangler secret put …`.

DATABASE_URL=postgresql://postgres@127.0.0.1:5432/chengzhang
BETTER_AUTH_SECRET=replace-with-long-random-secret
SESSION_SECRET=replace-with-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
AUTH_ALLOWED_EMAIL=you@example.com
