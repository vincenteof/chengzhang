# App
APP_ORIGIN=http://localhost:3000
NODE_ENV=development

# PostgreSQL (local dev / migrations / seed scripts)
# On Cloudflare Workers prefer Hyperdrive binding HYPERDRIVE, or set DATABASE_URL as a secret.
# Include DB user (required under Cloudflare/workerd). Local example:
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/chengzhang
# Workers / Hyperdrive: keep pool small (wrangler.jsonc default DB_POOL_MAX=1)
DB_POOL_MAX=10

# Session / Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-long-random-secret
SESSION_SECRET=replace-with-long-random-secret

# Single-user bootstrap (seed only; sign-up is disabled at runtime)
AUTH_ALLOWED_EMAIL=you@example.com
AUTH_PASSWORD=change-me-before-use
AUTH_NAME=Author

# Login rate limit
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MS=60000

# AI — 应用内「设置」页可配 GPT / Grok / DeepSeek 密钥（优先于环境变量）
# 未配置应用内密钥时：mock 无需密钥；openai 需 OPENAI_API_KEY
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_MODEL_PRIMARY=gpt-4o
AI_REQUEST_TIMEOUT_MS=90000

# --- Cloudflare Workers notes ---
# Local CF-shaped env: copy .dev.vars.example → .dev.vars
# Deploy secrets:
#   pnpm exec wrangler secret put DATABASE_URL
#   pnpm exec wrangler secret put BETTER_AUTH_SECRET
#   pnpm exec wrangler secret put BETTER_AUTH_URL
#   pnpm exec wrangler secret put APP_ORIGIN
#   # optional:
#   pnpm exec wrangler secret put OPENAI_API_KEY
# Production URL must match BETTER_AUTH_URL / APP_ORIGIN (cookie + CSRF).
