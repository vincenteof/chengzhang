# App public URL (must match the URL you open in the browser)
APP_ORIGIN=http://localhost:3000
NODE_ENV=development

# PostgreSQL
# Local `pnpm dev`: include a DB user. Docker Compose overrides this with the
# in-network postgres service.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/chengzhang
DB_POOL_MAX=10

# Docker Compose only (postgres container password)
POSTGRES_PASSWORD=chengzhang

# Session / Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-long-random-secret
SESSION_SECRET=replace-with-long-random-secret

# Single-user bootstrap (seed only; sign-up is disabled at runtime)
AUTH_ALLOWED_EMAIL=you@example.com
AUTH_PASSWORD=change-me-before-use
AUTH_NAME=Author

# Login rate limit
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MS=60000

# Uploaded images (Compose uses /data/media inside the container)
MEDIA_DIR=.tmp/media

# AI — 应用内「设置」页可配 GPT / Grok / DeepSeek 密钥（优先于环境变量）
# 未配置应用内密钥时：mock 无需密钥；openai 需 OPENAI_API_KEY
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_MODEL_PRIMARY=gpt-4o
AI_REQUEST_TIMEOUT_MS=90000
