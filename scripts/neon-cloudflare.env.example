# 复制为 neon-cloudflare.env 后按需修改（neon-cloudflare.env 已 gitignore）
#   cp scripts/neon-cloudflare.env.example scripts/neon-cloudflare.env
#
# Neon：
# - 本机 db:setup / migrate：优先 Direct（主机不要 -pooler）
# - Cloudflare Worker：推荐 Pooled（-pooler）+ 应用内 @neondatabase/serverless
#   （Workers 上 node-pg TCP 会 timeout；见 Neon serverless driver 文档）
# 含 & 的 URL 请用双引号包起来

# --- 数据库 ---
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# 可选：Worker 专用 Pooled（不填则 cf:secrets 用上面的 DATABASE_URL）
# CF_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- 单用户登录（seed + 线上登录）---
AUTH_ALLOWED_EMAIL=you@example.com
AUTH_PASSWORD=change-me-to-a-strong-password
AUTH_NAME=Author

# --- 会话密钥（两边一致；可先 openssl rand -hex 32 生成再粘贴）---
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
SESSION_SECRET=replace-with-same-as-better-auth-secret

# --- 网站地址 ---
# 本机跑 db:setup 时可先保持 localhost；deploy 后改成真实 workers.dev 再跑 secrets
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- 可选：线上 DATABASE_URL（若与上面不同，例如要用 Pooled）---
# CF_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
